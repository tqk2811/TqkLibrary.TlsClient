<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Native uTLS codec. Built by native\build.ps1 into runtimes\<rid>\native.
       Linked to the output root so DllImport("tqktls") resolves during local runs. -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\tqktls.dll" Link="tqktls.dll"
          Condition="Exists('runtimes\win-x64\native\tqktls.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
